[Unit]
Description=Lattice mining coordinator and external workers
After=lattice-node.service
Wants=lattice-node.service

[Service]
Type=simple
User=lattice
Group=lattice
# Required file, created mode 0640. Example:
# RECIPIENT_ARGS=--recipient Nexus=bafy... --recipient Nexus/Alpha=bafy...
EnvironmentFile=/etc/lattice/mining.env
ExecStartPre=/bin/sh -c 'test -n "$RECIPIENT_ARGS"'
ExecStart=/usr/local/bin/lattice-mining-coordinator \
  --node http://127.0.0.1:8080 \
  --worker-executable /usr/local/bin/lattice-miner \
  --workers 2 \
  $RECIPIENT_ARGS
Restart=always
RestartSec=5
LimitNOFILE=65536

WorkingDirectory=/var/lib/lattice

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lattice-mining-coordinator

[Install]
WantedBy=multi-user.target
