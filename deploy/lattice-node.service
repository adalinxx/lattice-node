[Unit]
Description=Lattice hosted chain tree
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lattice
Group=lattice
ExecStart=/usr/local/bin/lattice up --foreground --root /var/lib/lattice
ExecStop=/usr/local/bin/lattice down --root /var/lib/lattice
Restart=always
RestartSec=5
LimitNOFILE=65536

WorkingDirectory=/var/lib/lattice
StateDirectory=lattice
StateDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lattice-node

[Install]
WantedBy=multi-user.target
